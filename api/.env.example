# Copie para .env (local) ou cadastre como variáveis de ambiente na nuvem.

# Banco PostgreSQL (ex.: string de conexão do Neon). Pode colar como "postgresql://..." mesmo.
DATABASE_URL=postgresql://usuario:senha@servidor/chamados?sslmode=require

# Segredo para assinar os logins. Gere um longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Site autorizado a abrir chamados (a página do QR code no GitHub Pages)
CORS_ORIGINS=https://gabrielgermanoraphael-del.github.io

# Notificação no celular do TI. Use um tópico NOVO e difícil de adivinhar:
# ele fica só no servidor e não aparece mais na página.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

# Login dos professores com Google (veja "Login com Google" no README)
# Client ID do tipo "Aplicativo da Web" criado no Google Cloud
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# Só e-mails deste domínio conseguem entrar
DOMINIO_PERMITIDO=educ.indaiatuba.sp.gov.br
# Por quantos dias o professor fica logado no celular
PROFESSOR_TOKEN_DIAS=30

# Proteção contra abuso (opcional)
LIMITE_POR_PESSOA=10
LIMITE_POR_IP=60
JANELA_IP_SEG=600
JANELA_DUPLICADO_SEG=120
